# Server-only Cloudflare Worker runtime variables. No real credentials belong in Git.
# Existing team owner email remains configured in Sites.
TEAM_OWNER_EMAIL=company-owner@example.com
PUBLIC_APP_URL=
# 32 random bytes, base64url; generate once and keep backed up securely.
DRIVE_TOKEN_ENCRYPTION_KEY=
# Optional server configuration instead of the owner's Settings -> Google Disk form.
# An encrypted configuration saved through that form takes precedence.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# No frontend access token, Picker API key, or Google password is used.
# Web Push VAPID P-256 keys. Private d (base64url) is SERVER ONLY; public key is 65 raw bytes, base64url.
# Generate once; changing keys requires browsers to subscribe again.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Optional short-lived approved import; server secret only, remove after completion.
APPROVED_JOB_IMPORT=

# Narrow unattended reminder endpoint; SHA-256 of the existing Site service token.
# Configure through Sites runtime secrets; never copy the token into source or a schedule.
SERVICE_REMINDER_TOKEN_HASH=
# unconfigured | blocked_limit | active; displayed to administrators.
SERVICE_REMINDER_SCHEDULE_STATE=
# Preferred: owner/admin saves encrypted Resend configuration in app Settings.
# Uses existing DRIVE_TOKEN_ENCRYPTION_KEY with a separate AES-GCM context; preserve this master key.
# Environment values below are a fallback only when app configuration has never been saved.
# Transactional email via Resend: internal reminders and explicitly approved customer PDF reports.
# Configure secrets in hosting, never in frontend. Verify sender domain in Resend.
# Without app configuration, leave empty to disable sending. To turn off an existing app configuration, use its Disable button.
RESEND_API_KEY=
SERVICE_EMAIL_FROM=

# Unique physical installation ID from the new-company setup. Never bind another company's DB/R2.
INSTALLATION_ID=

# Volitelná jednorázová pozvánka administrátora nové instalace (role lze později měnit v Tým).
TEAM_INITIAL_ADMINISTRATOR_EMAIL=

# Optional central licensing (server secrets only; omit for standalone mode)
PLATFORM_CONTROL_URL=
PLATFORM_COMPANY_ID=
PLATFORM_SERVICE_TOKEN=
PLATFORM_SIGNING_PUBLIC_KEY=
PLATFORM_SIGNING_KEY_ID=
PLATFORM_CONTROL_BYPASS_TOKEN=
PLATFORM_REQUIRE_INVITATION=
